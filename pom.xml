<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <!-- Agregador e pai de todos os módulos (ADR-0002, D1 e D9), nas pastas por papel do ADR-0005 -->
    <groupId>br.com.encurtador</groupId>
    <artifactId>encurtador-url</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>encurtador-url</name>
    <description>Encurtador de URLs com Spring Boot, PostgreSQL, Redis e Kafka</description>

    <modules>
        <module>platform/shared</module>
        <module>platform/ratelimit</module>
        <module>platform/security-api</module>
        <module>platform/security</module>
        <module>modules/account</module>
        <module>modules/link</module>
        <module>modules/analytics</module>
        <module>modules/redirect</module>
        <!-- A API antes das outras aplicações: o spring-boot:run sem -pl sobe a primeira do reactor (ADR-0005, D7) -->
        <module>apps/api</module>
        <module>apps/auth-server</module>
        <module>frontend/web</module>
        <module>apps/bff</module>
        <module>tools/coverage</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <spring-modulith.version>2.1.2</spring-modulith.version>
        <springdoc.version>3.2.0</springdoc.version>
        <jacoco.version>0.8.16</jacoco.version>
        <jacoco.minimum-line-coverage>0.80</jacoco.minimum-line-coverage>
        <!-- Só as aplicações (apps/api, apps/auth-server, apps/bff) rodam com spring-boot:run; as bibliotecas o
             ignoram. Na raiz, sobe a API, a primeira do reactor; cada aplicação roda com -pl apps/<aplicação> -am
             (ADR-0003, D11; ADR-0005, D7) -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>br.com.encurtador</groupId>
                <artifactId>encurtador-url-shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.encurtador</groupId>
                <artifactId>encurtador-url-ratelimit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.encurtador</groupId>
                <artifactId>encurtador-url-security-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.encurtador</groupId>
                <artifactId>encurtador-url-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.encurtador</groupId>
                <artifactId>encurtador-url-account</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.encurtador</groupId>
                <artifactId>encurtador-url-link</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.encurtador</groupId>
                <artifactId>encurtador-url-analytics</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.encurtador</groupId>
                <artifactId>encurtador-url-redirect</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.encurtador</groupId>
                <artifactId>encurtador-url-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.encurtador</groupId>
                <artifactId>encurtador-url-auth-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.encurtador</groupId>
                <artifactId>encurtador-url-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.encurtador</groupId>
                <artifactId>encurtador-url-bff</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Spring Modulith não é gerenciado pelo BOM do Spring Boot (ADR-0001, D1) -->
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-common</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- O spring-boot:run roda na raiz do projeto, onde está o compose.yaml usado pelo perfil "local". A raiz
                     vem do mvnw e da IDE, e não da profundidade da pasta de cada aplicação (ADR-0005, D7) -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <configuration>
                        <excludes>
                            <exclude>br/com/encurtador/EncurtadorApplication.class</exclude>
                            <exclude>br/com/encurtador/**/config/**</exclude>
                            <exclude>br/com/encurtador/**/*Config.class</exclude>
                            <exclude>br/com/encurtador/**/*AutoConfiguration.class</exclude>
                            <exclude>br/com/encurtador/**/*Properties.class</exclude>
                            <exclude>br/com/encurtador/**/*Properties$*.class</exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Expõe o caminho do jar do Mockito para carregá-lo como agente (sem "dynamic agent loading") -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Testes unitários e de integração no Surefire; cada módulo gera o seu jacoco.exec (ADR-0002, D7) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>local</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <!-- Define a propriedade do Spring Boot dentro do perfil Maven -->
                <spring-boot.run.profiles>local</spring-boot.run.profiles>
            </properties>
        </profile>
    </profiles>
</project>
