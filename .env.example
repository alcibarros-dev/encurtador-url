# Variáveis para rodar fora do perfil "local" (o perfil local usa o compose.yaml e dispensa este arquivo).
# Copie para .env (ignorado pelo Git) e preencha.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/encurtador
SPRING_DATASOURCE_USERNAME=encurtador
SPRING_DATASOURCE_PASSWORD=troque-me

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Endereço público do serviço de redirecionamento (ADR-0006, D1): na API, é o prefixo do shortUrl; no redirect, o
# próprio endereço.
APP_BASE_URL=http://localhost:8060
# Tokens do auth-server (ADR-0003, D6): "iss" exigido (URL pública) e endereço do JWKS (pode ser interno).
APP_JWT_ISSUER=http://localhost:8090
APP_JWT_JWK_SET_URI=http://localhost:8090/oauth2/jwks

# auth-server (ADR-0003; imagem ghcr.io/alcibarros-dev/auth, ADR-0007). Fora do perfil "local", o datasource e o
# Redis usam as mesmas variáveis SPRING_* acima. Os clientes OAuth ficam em infra/auth-server/application.yml, montado
# em /config/application.yml; as variáveis abaixo trocam os endereços e o segredo dele.
AUTH_IMAGE_TAG=0.3.0
AUTH_ISSUER=http://localhost:8090
# PEM PKCS#8 da chave RSA de assinatura, com o prefixo file:. Gere com:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out .secrets/auth-signing-key.pem
AUTH_SIGNING_KEY_ID=auth-1
AUTH_SIGNING_KEY_FILE=file:.secrets/auth-signing-key.pem
# Segredo do cliente encurtador-web, o mesmo no auth-server e no BFF. Gere com: openssl rand -base64 32
AUTH_WEB_CLIENT_SECRET=
AUTH_WEB_REDIRECT_URIS=http://localhost:8070/login/oauth2/code/encurtador
AUTH_WEB_POST_LOGOUT_REDIRECT_URIS=http://localhost:8070/
AUTH_PANEL_ORIGINS=http://localhost:8070
AUTH_PANEL_DEFAULT_URL=http://localhost:8070/
AUTH_CORS_ALLOWED_ORIGINS=http://localhost:8080

# BFF do painel (ADR-0004, D12). Redis do rate limit pelas mesmas variáveis SPRING_DATA_REDIS_*.
# APP_BASE_URL do BFF é o endereço público do painel (http://localhost:8070 no local).
BFF_API_URL=http://localhost:8080
BFF_AUTH_PUBLIC_URL=http://localhost:8090
BFF_AUTH_INTERNAL_URL=http://localhost:8090
# O mesmo AUTH_WEB_CLIENT_SECRET do auth-server.
BFF_CLIENT_SECRET=
