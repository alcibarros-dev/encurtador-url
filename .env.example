# Variáveis para rodar fora do perfil "local" (o perfil local usa o compose.yaml e dispensa este arquivo).
# Copie para .env (ignorado pelo Git) e preencha.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/encurtador
SPRING_DATASOURCE_USERNAME=encurtador
SPRING_DATASOURCE_PASSWORD=troque-me

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

APP_BASE_URL=http://localhost:8080
# Base64 de pelo menos 32 bytes aleatórios. Gere com: openssl rand -base64 48
APP_JWT_SECRET=
