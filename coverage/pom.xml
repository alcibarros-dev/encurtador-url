<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.encurtador</groupId>
        <artifactId>encurtador-url</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <!--
        Gate de cobertura agregado (ADR-0002, D7). O jacoco:check só mede as classes do próprio módulo, e os testes de
        integração do app cobrem as classes dos outros. Por isso este módulo, o último do reactor, descompacta as classes
        de todos os módulos, junta os jacoco.exec e aplica o gate sobre o exec unificado.
    -->
    <artifactId>encurtador-url-coverage</artifactId>
    <name>encurtador-url-coverage</name>
    <packaging>pom</packaging>

    <properties>
        <coverage.merged-exec>${project.build.directory}/jacoco-merged.exec</coverage.merged-exec>
    </properties>

    <dependencies>
        <dependency>
            <groupId>br.com.encurtador</groupId>
            <artifactId>encurtador-url-shared</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.encurtador</groupId>
            <artifactId>encurtador-url-ratelimit</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.encurtador</groupId>
            <artifactId>encurtador-url-security-api</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.encurtador</groupId>
            <artifactId>encurtador-url-security</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.encurtador</groupId>
            <artifactId>encurtador-url-link</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.encurtador</groupId>
            <artifactId>encurtador-url-analytics</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.encurtador</groupId>
            <artifactId>encurtador-url-redirect</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.encurtador</groupId>
            <artifactId>encurtador-url-app</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-module-classes</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>unpack-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeGroupIds>br.com.encurtador</includeGroupIds>
                            <includes>br/**</includes>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>merge</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.basedir}/..</directory>
                                    <includes>
                                        <include>**/target/jacoco.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <destFile>${coverage.merged-exec}</destFile>
                        </configuration>
                    </execution>
                    <!-- Relatório com o código-fonte de cada módulo em target/site/jacoco-aggregate -->
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFile>${coverage.merged-exec}</dataFile>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum-line-coverage}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
